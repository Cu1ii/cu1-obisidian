# 复制为 .env，填入强密码
# cp .env.example .env
# chmod 600 .env

# ─── SERVER_ROOT ────────────────────────────────────────────────
# 部署根，绝对路径。两种注入方式择一（详见 init.md「路径约定」）：
#
# 方式 A（推荐，跨机器）：shell export，注释掉下行
#   echo 'export SERVER_ROOT="$HOME/fyj-server"' >> ~/.zshrc && source ~/.zshrc
#
# 方式 B（机器固定）：取消注释，填写绝对路径，禁止用 ~ 或 $HOME（dotenv 不展开）
SERVER_ROOT=/Users/fyj/fyj-server
# ────────────────────────────────────────────────────────────────
# Cat 服务 ip
CAT_SERVER_IP=localhost

# Cat 容器在 infra-net 上之静态 IP（监控身份）
# 必须落在 infra-net 之 subnet 内，且不与 gateway / 其它 container 冲突
# 查 subnet：docker network inspect infra-net | grep -A4 IPAM
CAT_CONTAINER_IP=192.168.97.10

# 时区
TZ=Asia/Shanghai

# 中间件凭证
MYSQL_ROOT_PASSWORD=请改成强密码至少16位
REDIS_PASSWORD=请改成强密码至少16位

# Kafka advertised host：开发机/容器外用此地址连 9094
# 本机调试填 localhost；LAN 调试填 Mac LAN IP（如 192.168.1.10）
KAFKA_ADVERTISED_HOST=localhost
